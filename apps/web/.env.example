# Public HiveMQ broker works with no account.
# For HiveMQ Cloud use mqtts://<id>.s1.eu.hivemq.cloud:8883 + username/password.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Public broker is shared: keep this prefix unique to you.
TOPIC_PREFIX=smartlock-jelic
PORT=3000

# Only if you later split the backend out: browser WebSocket URL.
# Empty = same-origin /ws (integrated mode).
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
